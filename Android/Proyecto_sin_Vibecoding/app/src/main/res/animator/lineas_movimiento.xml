<?xml version="1.0" encoding="utf-8"?>
<!-- Muestra las lineas de movimiento solo mientras el celular se sacude. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1400"
    android:repeatCount="infinite">
    <propertyValuesHolder android:propertyName="strokeAlpha">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.05" android:value="1" />
        <keyframe android:fraction="0.45" android:value="1" />
        <keyframe android:fraction="0.55" android:value="0" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
