<?xml version="1.0" encoding="utf-8"?>
<!-- Gira el celular de un lado a otro y luego hace una pausa; se repite sin fin. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1400"
    android:repeatCount="infinite">
    <propertyValuesHolder android:propertyName="rotation">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.1" android:value="-18" />
        <keyframe android:fraction="0.2" android:value="18" />
        <keyframe android:fraction="0.3" android:value="-18" />
        <keyframe android:fraction="0.4" android:value="18" />
        <keyframe android:fraction="0.5" android:value="0" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
