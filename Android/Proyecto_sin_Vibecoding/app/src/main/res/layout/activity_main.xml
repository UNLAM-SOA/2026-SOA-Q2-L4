<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/margen_pantalla"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_monitoreo"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/color_primario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_8"
                android:text="@string/titulo_principal"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_8"
                android:text="@string/subtitulo_principal"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/texto_secundario" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_16"
                app:cardBackgroundColor="@color/superficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_secundaria"
                app:cardElevation="@dimen/sin_elevacion"
                app:strokeColor="@color/borde"
                app:strokeWidth="@dimen/grosor_borde">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espaciado_16">

                    <View
                        android:id="@+id/viewConexion"
                        android:layout_width="@dimen/tamano_indicador_conexion"
                        android:layout_height="@dimen/tamano_indicador_conexion"
                        android:background="@drawable/indicador_conexion"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvConexion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_12"
                        android:layout_weight="1"
                        android:text="@string/conexion_conectando"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/texto_principal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_16"
                app:cardBackgroundColor="@color/superficie"
                app:cardCornerRadius="@dimen/radio_tarjeta"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeColor="@color/borde"
                app:strokeWidth="@dimen/grosor_borde">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espaciado_20">

                    <ImageView
                        android:id="@+id/ivEstado"
                        android:layout_width="@dimen/tamano_icono_estado"
                        android:layout_height="@dimen/tamano_icono_estado"
                        android:contentDescription="@string/descripcion_icono_estado"
                        android:src="@drawable/ic_estado"
                        android:tint="@color/color_primario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/etiqueta_estado"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/texto_secundario"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEstado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espaciado_8"
                            android:text="@string/estado_inicial"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/texto_principal"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_16"
                app:cardBackgroundColor="@color/fondo_estado"
                app:cardCornerRadius="@dimen/radio_tarjeta"
                app:cardElevation="@dimen/sin_elevacion">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaciado_20">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_temperatura"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/texto_secundario"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTemperatura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaciado_8"
                        android:text="@string/temperatura_inicial"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                        android:textColor="@color/texto_principal"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_24"
                android:layout_marginBottom="@dimen/espaciado_8"
                android:text="@string/etiqueta_control"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSilenciar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_boton"
                    android:layout_marginEnd="@dimen/espaciado_8"
                    android:layout_weight="1"
                    android:text="@string/boton_silenciar"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primario"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    app:backgroundTint="@color/color_primario"
                    app:cornerRadius="@dimen/radio_boton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReactivar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_boton"
                    android:layout_marginStart="@dimen/espaciado_8"
                    android:layout_weight="1"
                    android:text="@string/boton_reactivar"
                    android:textAllCaps="false"
                    android:textColor="@color/estado_error"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    app:cornerRadius="@dimen/radio_boton"
                    app:strokeColor="@color/estado_error" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrafico"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_boton"
                android:layout_marginTop="@dimen/espaciado_8"
                android:text="@string/boton_grafico"
                android:textAllCaps="false"
                android:textColor="@color/color_primario"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                app:cornerRadius="@dimen/radio_boton"
                app:strokeColor="@color/color_primario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_16"
                android:gravity="center"
                android:text="@string/ayuda_sacudida"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/texto_secundario" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
